# --- Database ---------------------------------------------------------------
# Production: a Postgres connection string with the `vector` extension available
# (Neon and Supabase both ship it). Leave unset for local development and the
# app falls back to an in-process PGlite database under .pgdata/, which speaks
# the same SQL and loads the same vector extension.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Site identity ----------------------------------------------------------
SITE_URL=http://localhost:3000
SITE_TITLE=example.fyi
SITE_AUTHOR=Your Name
SITE_AUTHOR_ROLE=Software engineer
SITE_TAGLINE=What I'm reading, noticing, questioning, concluding, and revising.
SITE_ESSAYS_URL=https://example.com
SITE_CONTACT_EMAIL=hello@example.fyi

# --- Ingest auth ------------------------------------------------------------
# Bearer token required by POST /api/ingest and the /admin capture UI.
# Generate with: openssl rand -hex 32
INGEST_TOKEN=

# --- LLM + embeddings -------------------------------------------------------
# Any OpenAI-compatible endpoint works. Without a key the pipeline still runs
# but falls back to extractive summaries and skips edge proposals.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Graph tuning -----------------------------------------------------------
# Minimum connections before an item is promoted to a theme hub.
THEME_HUB_THRESHOLD=3
# Candidate neighbours considered per publish, and the confidence floor and cap
# applied to the edges the judge proposes.
EDGE_CANDIDATE_COUNT=15
EDGE_CONFIDENCE_FLOOR=0.55
EDGE_MAX_PER_ITEM=8
